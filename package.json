{
  "name": "tedx-core-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck:files": "tsc --noEmit -p tsconfig.files.json",
    "test:dependencies": "node scripts/test-dependencies.cjs",
    "test:synergy-interface": "node scripts/test-synergy-interface.cjs",
    "test:synergy": "node scripts/test-synergy.cjs",
    "test:files": "node scripts/test-files.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:identity": "node scripts/test-identity.cjs",
    "test:authorization": "node scripts/test-authorization.cjs",
    "test:google-auth": "node scripts/test-google-auth.cjs",
    "test:guests": "node scripts/test-guests.cjs",
    "test:directory": "node scripts/test-directory.cjs",
    "test:work-access": "node scripts/test-work-access.cjs",
    "test:deliverables": "node scripts/test-deliverables.cjs",
    "test:deliverable-authoring": "node scripts/test-deliverable-authoring.cjs",
    "test:tasks": "node scripts/test-tasks.cjs && node scripts/test-task-commands.cjs",
    "test:comments": "node scripts/test-comments.cjs",
    "test:task-commands": "node scripts/test-task-commands.cjs",
    "db:types": "node scripts/generate-identity-types.cjs",
    "db:types:check": "node scripts/generate-identity-types.cjs --check",
    "build": "vite build"
  },
  "dependencies": {
    "@fontsource-variable/karla": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "supabase": "2.122.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
