# These two values are public browser configuration, not server credentials.
# Copy this file to .env.local when configuring a project, then restart Vite.
# Leave blank to run the unconfigured foundation safely.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never put secret/service-role keys, database passwords or OAuth secrets here.
# Every VITE_ variable can be exposed in browser code.
