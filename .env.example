# These values are public browser configuration, not server credentials.
# Copy this file to .env.local when configuring a project, then restart Vite.
# Leave blank to run the unconfigured foundation safely.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Required for the Pages build. One exact HTTPS origin, without a trailing slash.
# Leave empty for the two supported local loopback origins.
VITE_APP_ORIGIN=
# Optional Drive Picker stays off unless a named HTTPS environment is approved.
VITE_DRIVE_PICKER_ENABLED=
# Optional private Drive renditions for publicity drafts.
VITE_DRIVE_EVIDENCE_ENABLED=
# Optional publishing to the separately approved Google Calendar.
VITE_CALENDAR_SYNC_ENABLED=
# Optional approved Telegram bot username. Leave blank to hide Telegram settings.
VITE_TELEGRAM_BOT_USERNAME=
# Optional digest controls for an authorized email environment.
VITE_EMAIL_DIGEST_ENABLED=
# Never put secret/service-role keys, database passwords or OAuth secrets here.
# Every VITE_ variable can be exposed in browser code.
